PORT=5000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- OTP / WhatsApp delivery -------------------------------------------------
# Provider used to deliver password-reset OTPs and WhatsApp notifications:
# 'meta' (WhatsApp Cloud API), 'twilio' (SMS), or 'mock' (dev fallback only).
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta)
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# Approved OTP template name + language (create it in Meta Business Manager).
# Body should be something like: "Your GK OTP is {{1}}. Valid for 10 minutes."
WHATSAPP_OTP_TEMPLATE=gk_otp
WHATSAPP_OTP_TEMPLATE_LANG=en

# Twilio SMS (WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
